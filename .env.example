# RepoPilot 設定範例；複製為 .env 後依需要修改。請勿放入真實金鑰。
APP_NAME=RepoPilot
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 預設值對應 docker-compose.yml 的 db（本機假密碼）；請勿放入真實帳密
DATABASE_URL=postgresql+psycopg://repopilot:repopilot_dev@127.0.0.1:5432/repopilot
DB_CONNECT_TIMEOUT_SECONDS=5
# 連線池（預設值同 SQLAlchemy，未經實測）：常駐連線數、額外可借數、池滿時等待秒數
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# 允許註冊的本機 repo 根目錄；多個以 ; 分隔（Linux／macOS 為 :）。空白＝拒絕所有註冊
# 例：REPOSITORY_ROOTS=D:\repos;D:\work
REPOSITORY_ROOTS=
# 單一 Git 指令逾時秒數
GIT_TIMEOUT_SECONDS=30
# 匯入上限（位元組／檔案數／秒）；超過單檔上限的檔案記為 skipped，超過檔案數或總大小則整個匯入失敗
# IMPORT_MAX_FILE_BYTES=1048576
# IMPORT_MAX_FILES=20000
# IMPORT_MAX_SNAPSHOT_BYTES=209715200
# IMPORT_GIT_TIMEOUT_SECONDS=300
# 搜尋（切片 8）：每個搜尋請求的時間上限（秒）；超過回 504 search_timeout。預設值只在合成快照上量測過一次
# SEARCH_STATEMENT_TIMEOUT_SECONDS=10
# 第三階段隔離 embedding（尚未提供向量搜尋介面）：路徑由 Docker Compose 使用，SHA-256 由 API 使用。
# 模型雜湊可用 Get-FileHash -Algorithm SHA256 計算；執行器雜湊由隔離服務啟動日誌提供。
# 兩個雜湊也須設定在 .env.worker；不要把模型檔放進 Git repo。
# EMBEDDING_MODEL_HOST_PATH=D:/models/example.gguf
# EMBEDDING_MODEL_SHA256=
# EMBEDDING_RUNTIME_SHA256=
# 隔離 embedding 服務的算力設定（只影響速度，不影響 EMBEDDING_RUNTIME_SHA256；由 Docker Compose 使用）：
# 執行緒數預設 8（實測 2→8 約 3 倍，更多收益很小，但會讓電腦明顯變慢）。
# CPU 與 GPU 是兩個各自的 embedding 服務（GPU：profile embedding-gpu），索引工作在介面上選用哪一個，見 README。
# EMBEDDING_THREADS=8
# 查詢橋接使用僅限本機的 port 及 32～128 個 URL-safe 字元的高熵 token。
# 使用 Python secrets.token_urlsafe(32) 產生專用 token；不要提交、分享或記錄它。
# EMBEDDING_GATEWAY_PORT=18763
# EMBEDDING_GATEWAY_TOKEN=
# SQL 結構索引預設不猜測方言；可設定 postgres、tsql、mysql 或 sqlite。
# 特定檔名如 schema.tsql.sql 可覆寫預設方言；沒有方言的 .sql 會列為無法解析。
# INDEX_SQL_DIALECT=postgres
# SQL 解析單檔上限（位元組），超過會明確標記，數值未經效能驗收
# INDEX_SQL_MAX_FILE_BYTES=20000
# blob 分批讀取（背景匯入的進度與取消延遲取決於它；不影響匯入結果、不納入 import_profile_hash）：
# 每批最多這麼多個不同的 blob、且合計不超過這麼多位元組（單一超大 blob 獨占一批）。預設值未實測
# IMPORT_BLOB_BATCH_MAX_FILES=200
# IMPORT_BLOB_BATCH_MAX_BYTES=4194304
# importing 超過此秒數視為程序中斷，允許後續請求接手
# IMPORT_STALE_SECONDS=1800
# 排除規則（JSON 陣列，比對檔名、不分大小寫）；會取代預設值並納入 import_profile_hash
# IMPORT_EXCLUDED_PATTERNS=[".env", ".env.*", "*.pem"]
# IMPORT_EXCLUDED_EXCEPTIONS=[".env.example"]
# GitHub token（切片 5c）：token 本身不放在 .env，由使用者經 API／介面提交後以密文存入資料庫
# TOKEN_ENCRYPTION_KEY 是加密用的 Fernet 金鑰：空白＝無法保存 token，沒有預設金鑰；請勿入版控、請勿放真實值到範例檔
# 產生：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 金鑰遺失或更換後，已保存的 token 無法解密，需重新提交
TOKEN_ENCRYPTION_KEY=
# 預設即可；僅供測試時指向本機假 GitHub
# GITHUB_API_BASE_URL=https://api.github.com
# 呼叫 GitHub API 的逾時秒數（未實測）
# GITHUB_API_TIMEOUT_SECONDS=10
# GitHub repo 註冊（切片 5c-2）：clone 的目的地（受信任的「受管目錄」，與 REPOSITORY_ROOTS 分開）。
# 須為絕對路徑；空白＝停用 GitHub 註冊（POST /api/v1/repositories/github 回 503 github_registration_disabled）。
# 啟動時不會建立此目錄，第一次註冊時才建立；clone 位於 <MANAGED_REPOS_DIR>\github\<owner>\<name>。
# 請勿把它放進 REPOSITORY_ROOTS，也不要指向既有的重要目錄；範例（假路徑）：D:\repopilot-managed
MANAGED_REPOS_DIR=
# 單次 git clone／fetch 的逾時秒數（預設 300，未實測；大型 repo 可能需要調高）
# GITHUB_CLONE_TIMEOUT_SECONDS=300
# clone 的遠端基底 URL；預設即可，僅供測試指向本機 fixture（只接受 https、file，或本機迴圈位址的 http）
# GITHUB_CLONE_BASE_URL=https://github.com
# 第二階段背景工作的 docker compose 插值（只供 docker compose 讀取，後端不會讀這兩個變數）：
# worker 容器的掛載來源（主機路徑，須為 Docker Desktop 已共用的磁碟機；repos 以唯讀、managed 以讀寫掛載）。
# **請用正斜線**（D:/repos）：同一個值會被插進 WORKER_PATH_MAPPINGS 的 JSON，反斜線會變成無效的跳脫序列。
# 範例（假路徑）：D:/repos 與 D:/repopilot-managed；它們必須分別涵蓋 REPOSITORY_ROOTS 與 MANAGED_REPOS_DIR。
# 未設定時預設為專案內的相對路徑，worker 會在啟動時以明確錯誤拒絕（相對路徑不是合法的主機路徑）。
# WORKER_REPOSITORIES_HOST_DIR=D:/repos
# WORKER_MANAGED_HOST_DIR=D:/repopilot-managed
# 背景工作（第二階段切片 2 的狀態機、切片 3 的 dispatcher／worker）。
# 以下皆為「擬議起點」，**未經實測**，預設值即可，不需要設定。
# 租約秒數與心跳秒數（心跳須小於租約；worker 每隔心跳秒數延長租約，租約過期代表 worker 失聯）
# JOB_LEASE_SECONDS=60
# JOB_HEARTBEAT_SECONDS=15
# 每個工作最多自動執行幾次（含第一次）；手動 retry 時以「目前次數＋此值」作為新額度
# JOB_MAX_ATTEMPTS=3
# 暫時性失敗的指數退避：min(上限, 基數 × 2^(n-1))，再加 ±20% 抖動（秒）
# JOB_RETRY_BASE_SECONDS=30
# JOB_RETRY_MAX_SECONDS=600
# dispatcher 掃描待派送事件的間隔、復原掃描間隔（秒；只有 dispatcher 程序使用）
# DISPATCH_POLL_SECONDS=1
# RECOVERY_SCAN_SECONDS=5
# 已派送但工作仍在排隊超過此秒數就重送（之後逐次加倍，上限 60 分鐘）
# DISPATCH_RESEND_AFTER_SECONDS=300
# dispatcher／worker 寫入存活心跳的週期；超過 3 倍未更新，GET /api/v1/jobs/status 視為離線
# SERVICE_HEARTBEAT_SECONDS=15
# --- 第二階段切片 3：Celery／Redis 與 worker（以下是給 dispatcher 與 worker 程序用的設定；
# 在 docker-compose.yml 內以容器內的值設定好了，API 程序不讀它們，也不連 Redis）---
# broker 位址、佇列名稱與 Redis 鍵前綴（測試堆疊用不同的值，不與開發堆疊共用）
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_QUEUE_NAME=repopilot.jobs
# CELERY_GLOBAL_KEYPREFIX=repopilot:
# 主機路徑 ↔ 容器路徑（JSON 陣列）。**API 也需要**它：建立 import-job 時檢查 repo 路徑能映射到容器，
# 否則回 503 worker_path_not_mapped。host 與 compose 的 bind mount 來源相同（正斜線或反斜線皆可，
# 反斜線在 JSON 內要寫成 \\），mode 為 ro（使用者 repo）或 rw（受管目錄）；
# 例（假路徑）：
# WORKER_PATH_MAPPINGS=[{"host":"D:/repos","container":"/mnt/repos","mode":"ro"},{"host":"D:/repopilot-managed","container":"/mnt/managed","mode":"rw"}]
# worker 的 Git 逾時（R1，未實測）：容器讀 Windows 掛載較慢，loose 物件極多的 repo 可能逾時；
# 逾時時 job 的錯誤訊息提示可在該 repo 自行執行 `git gc`。這兩個值只影響 worker
# WORKER_GIT_TIMEOUT_SECONDS=120
# WORKER_IMPORT_GIT_TIMEOUT_SECONDS=900
# 任務硬上限（秒）；必須大於 WORKER_IMPORT_GIT_TIMEOUT_SECONDS 加上 4 倍 WORKER_GIT_TIMEOUT_SECONDS
# WORKER_TASK_TIME_LIMIT_SECONDS=3600
# 整合測試用：僅讀取環境變數 TEST_DATABASE_URL，不會讀 .env；未設定時使用此預設值（資料庫名稱必須含 test）
# TEST_DATABASE_URL=postgresql+psycopg://repopilot:repopilot_test@127.0.0.1:5433/repopilot_test
