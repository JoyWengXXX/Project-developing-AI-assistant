# RepoPilot 設定範例；複製為 .env 後依需要修改。請勿放入真實金鑰。
APP_NAME=RepoPilot
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 預設值對應 docker-compose.yml 的 db（本機假密碼）；請勿放入真實帳密
DATABASE_URL=postgresql+psycopg://repopilot:repopilot_dev@127.0.0.1:5432/repopilot
DB_CONNECT_TIMEOUT_SECONDS=5
# 連線池（預設值同 SQLAlchemy，未經實測）：常駐連線數、額外可借數、池滿時等待秒數
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# 允許註冊的本機 repo 根目錄；多個以 ; 分隔（Linux／macOS 為 :）。空白＝拒絕所有註冊
# 例：REPOSITORY_ROOTS=D:\repos;D:\work
REPOSITORY_ROOTS=
# 單一 Git 指令逾時秒數
GIT_TIMEOUT_SECONDS=30
# 匯入上限（位元組／檔案數／秒）；超過單檔上限的檔案記為 skipped，超過檔案數或總大小則整個匯入失敗
# IMPORT_MAX_FILE_BYTES=1048576
# IMPORT_MAX_FILES=20000
# IMPORT_MAX_SNAPSHOT_BYTES=209715200
# IMPORT_GIT_TIMEOUT_SECONDS=300
# importing 超過此秒數視為程序中斷，允許後續請求接手
# IMPORT_STALE_SECONDS=1800
# 排除規則（JSON 陣列，比對檔名、不分大小寫）；會取代預設值並納入 import_profile_hash
# IMPORT_EXCLUDED_PATTERNS=[".env", ".env.*", "*.pem"]
# IMPORT_EXCLUDED_EXCEPTIONS=[".env.example"]
# 整合測試用：僅讀取環境變數 TEST_DATABASE_URL，不會讀 .env；未設定時使用此預設值（資料庫名稱必須含 test）
# TEST_DATABASE_URL=postgresql+psycopg://repopilot:repopilot_test@127.0.0.1:5433/repopilot_test
