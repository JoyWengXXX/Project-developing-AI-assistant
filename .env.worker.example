# worker／dispatcher 容器的額外環境變數範例（第二階段切片 3）。
# 複製為 `.env.worker`（已被 .gitignore 的 `.env.*` 排除，不會進入版本控制），再填入真實值。
# `.env.worker` 不存在時 Compose 照常啟動（env_file 設為 required: false），只是沒有這些設定。
#
# 注意：docker inspect 看得到容器的環境變數，所以能執行 docker 的本機使用者看得到這些值；
# 單一使用者的本機部署可接受（殘留風險，規格 9.7）。下面都是假值。

# GitHub token 的解密金鑰（Fernet）。切片 3 的 worker 只匯入既有 repo、不使用 token；
# 切片 5（GitHub 註冊與 fetch 背景化）起才需要，且必須與 API 使用同一把。
# 產生方式：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=FAKE_KEY_FOR_EXAMPLE_ONLY

# 匯入設定必須與 API（根目錄 .env）一致，否則 worker 會以 profile_mismatch 拒絕 job。
# 只有你在 .env 改過預設值時才需要在這裡設同樣的值：
# IMPORT_MAX_FILE_BYTES=1048576
# IMPORT_MAX_FILES=20000
# IMPORT_MAX_SNAPSHOT_BYTES=209715200
# IMPORT_EXCLUDED_PATTERNS=[".env", ".env.*", "*.pem"]
# IMPORT_EXCLUDED_EXCEPTIONS=[".env.example"]

# worker 的 Git 逾時（R1）。預設值未實測；容器讀 Windows 掛載比主機慢，
# loose 物件極多、從未 gc 的 repo 可能超過預設逾時（切片 1 實測：20,000 個 loose 物件約 391 秒）。
# 逾時時 job 的錯誤訊息會提示：可在該 repo 自行執行 `git gc`，或調高這兩個值。
# WORKER_GIT_TIMEOUT_SECONDS=120
# WORKER_IMPORT_GIT_TIMEOUT_SECONDS=900
# 任務硬上限（秒）；必須大於 WORKER_IMPORT_GIT_TIMEOUT_SECONDS 加上 4 倍 WORKER_GIT_TIMEOUT_SECONDS
# WORKER_TASK_TIME_LIMIT_SECONDS=3600

# 日誌等級（DEBUG | INFO | WARNING | ERROR）
# LOG_LEVEL=INFO
